# GATE Production Environment Configuration
# Copy this file to .env.production and fill in all values
# ============================================================

# ===== Application =====
ENVIRONMENT=production
DEBUG=false

# ===== Security =====
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-256-bit-secret-key-here

# ===== Domain =====
DOMAIN=gate.yourbrokerage.com
CORS_ORIGINS=["https://gate.yourbrokerage.com"]

# ===== Database =====
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://gate_user:your-db-password@db-host:5432/gate_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ===== Redis =====
REDIS_URL=redis://redis-host:6379/0
CELERY_BROKER_URL=redis://redis-host:6379/1

# ===== File Storage =====
# Options: local, s3, gcs, azure
STORAGE_TYPE=s3
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_S3_BUCKET=gate-documents
AWS_REGION=us-east-1

# ===== Email (SendGrid recommended) =====
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-sendgrid-api-key
FROM_EMAIL=noreply@yourbrokerage.com
FROM_NAME=GATE Customs Brokerage

# ===== Stripe Billing =====
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_starter_id
STRIPE_PRICE_PROFESSIONAL=price_professional_id
STRIPE_PRICE_ENTERPRISE=price_enterprise_id

# ===== ACE Integration (CBP) =====
ACE_API_URL=https://ace.cbp.dhs.gov
ACE_CLIENT_ID=your-ace-client-id
ACE_CLIENT_SECRET=your-ace-secret
FILER_CODE=your-filer-code

# ===== AI/Document Processing (Optional) =====
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ===== Error Tracking (Optional) =====
SENTRY_DSN=https://xxx@sentry.io/xxx

# ===== Performance =====
API_WORKERS=4
WORKER_CONCURRENCY=4
