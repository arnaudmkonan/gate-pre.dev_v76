# GATE Production Environment Configuration
# Copy this file to .env.production and fill in all values
# The API will REFUSE to start in production if starred (*) values are missing.
# ============================================================

# ===== Application =====
ENVIRONMENT=production
DEBUG=false

# ===== Security =====
# * REQUIRED. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-256-bit-secret-key-here

# ===== Domain =====
DOMAIN=gate.yourbrokerage.com
CORS_ORIGINS=https://gate.yourbrokerage.com
# CORS_ALLOW_ALL=false  # Never set to true in production

# ===== Database =====
# * REQUIRED. PostgreSQL 15+ with pgvector extension.
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://gate_user:your-db-password@db-host:5432/gate_db
DATABASE_URL_SYNC=postgresql+psycopg2://gate_user:your-db-password@db-host:5432/gate_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ===== Redis =====
# * REQUIRED for rate limiting correctness across workers.
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_URL=redis://your-redis-host:6379/0
CELERY_BROKER_URL=redis://your-redis-host:6379/1
CELERY_RESULT_BACKEND=redis://your-redis-host:6379/2
# Rate limiter uses DB 3 to avoid collisions with Celery
RATE_LIMIT_STORAGE=redis://your-redis-host:6379/3

# ===== Email (Password Reset + Notifications) =====
# * REQUIRED. The API will refuse to start without SMTP_HOST in production.
# Option A: SendGrid
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=your-sendgrid-api-key
FROM_EMAIL=noreply@yourbrokerage.com
FROM_NAME=GATE Customs Brokerage

# Option B: AWS SES (uncomment and swap)
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USERNAME=your-ses-smtp-user
# SMTP_PASSWORD=your-ses-smtp-password

# ===== File Storage =====
# Options: s3, local
STORAGE_TYPE=s3
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_S3_BUCKET=gate-documents
AWS_REGION=us-east-1

# ===== Stripe Billing =====
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_starter_id
STRIPE_PRICE_PROFESSIONAL=price_professional_id
STRIPE_PRICE_ENTERPRISE=price_enterprise_id

# ===== ACE Integration (CBP) =====
ACE_SFTP_ENABLED=false   # Set to true only when CBP credentials are provisioned
ACE_SFTP_HOST=ace.cbp.dhs.gov
ACE_SFTP_PORT=22
ACE_SFTP_USER=your-filer-code
ACE_SFTP_KEY_PATH=/app/certs/cbp_rsa_key
ACE_KNOWN_HOSTS_PATH=/app/certs/ace_known_hosts
FILER_CODE=your-filer-code

# ===== AI/Document Processing =====
# Rotate if previously exposed. See SECRETS_CHECKLIST.md.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ===== Error Tracking =====
SENTRY_ENABLED=true
SENTRY_DSN=https://xxx@sentry.io/xxx
SENTRY_ENV=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ===== Performance =====
API_WORKERS=4        # gunicorn worker count (CPU cores × 2 + 1 is a good baseline)
WORKER_CONCURRENCY=4  # Celery worker concurrency
