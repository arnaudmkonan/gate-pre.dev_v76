# -----------------------------------------------------------------------------
# Boutique broker PILOT instance overrides
# Copy values into instances/<customer_id>/.env after provision.sh
# Full guide: docs/PILOT_ONBOARDING.md
# -----------------------------------------------------------------------------

ENVIRONMENT=production
SEED_DEMO_USERS=false
REQUIRE_EMAIL_VERIFICATION=true

# Broker identity (also set BROKER_FILER_CODE before running provision.sh)
BROKER_NAME=Acme Customs Brokerage
BROKER_FILER_CODE=AB1
BROKER_DEFAULT_PORT=
CARGOWISE_COMPANY_CODE=ACME
CARGOWISE_ENTERPRISE_ID=ACME-CW1
AUDIT_LOG_RETENTION_DAYS=2555

# Public URLs (HTTPS — see docs/PILOT_HTTPS.md)
FRONTEND_URL=https://acme.gateplatform.com
PUBLIC_APP_URL=https://acme.gateplatform.com

# Required for extraction
OPENAI_API_KEY=sk-...

# Outbound email (resets + Request Missing Doc) — see docs/PILOT_SMTP.md
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@acme-customs.example
SMTP_TLS=true

# ACE: pilot default = export-only (no fake CBP filing)
ACE_SFTP_ENABLED=false
ACE_ALLOW_SIMULATION=false
# ACE_SFTP_HOST=
# ACE_SFTP_PORT=22
# ACE_SFTP_USER=
# ACE_SFTP_KEY_PATH=./certs/ace_private_key.pem

# Frontend brand (bake-time — rebuild web image after change)
VITE_BRAND_NAME=Acme Customs Brokerage
VITE_BRAND_SUBTITLE=Entry Prep Workbench
VITE_ENABLE_DEMO_LOGIN=false
VITE_ENABLE_ACE_SIMULATION=false

# Storage / callbacks
STORAGE_PROVIDER=local
# STORAGE_CALLBACK_SECRET=  # openssl rand -hex 32
