# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/doc_ingestion
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/doc_ingestion

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Storage
STORAGE_PROVIDER=supabase
SUPABASE_STORAGE_ENDPOINT=https://your-project.supabase.co/storage/v1/s3
SUPABASE_STORAGE_ACCESS_KEY=your_access_key
SUPABASE_STORAGE_SECRET_KEY=your_secret_key
SUPABASE_STORAGE_BUCKET=raw-files
SUPABASE_STORAGE_REGION=us-east-1
MAX_UPLOAD_SIZE_MB=100
SIGNED_URL_TTL_SECONDS=3600

# Redis & Celery
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Vector Store
VECTOR_STORE_BACKEND=supabase
VECTOR_STORE_URL=https://your-project.supabase.co
OPENAI_API_KEY=sk-your-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# API
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=False

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256

# Sentry
SENTRY_DSN=
SENTRY_ENV=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENABLED=false

# Backup & Storage
S3_BACKUP_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
BACKUP_RETENTION_DAYS=30
ENCRYPTION_PASSPHRASE=

# Environment
ENVIRONMENT=development

# CORS (comma-separated origins for production)
CORS_ORIGINS=https://app.gateplatform.com,https://*.gateplatform.com

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_BURST=200/minute
RATE_LIMIT_STORAGE=memory://
# Customer Tier Limits (requests per minute)
TIER_STARTER_LIMIT=60
TIER_PROFESSIONAL_LIMIT=200
TIER_ENTERPRISE_LIMIT=1000

# ACE Transmission (CBP SFTP)
# Set ACE_SFTP_ENABLED=true for live transmission
ACE_SFTP_ENABLED=false
ACE_SFTP_HOST=
ACE_SFTP_PORT=22
ACE_SFTP_USER=
ACE_SFTP_KEY_PATH=./certs/ace_private_key.pem
ACE_UPLOAD_PATH=/incoming
ACE_RESPONSE_PATH=/outgoing

# Email Ingestion (optional - for auto-processing email attachments)
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USER=your-email@gmail.com
EMAIL_IMAP_PASSWORD=your-app-password
EMAIL_FOLDER=INBOX
EMAIL_PROCESSED_FOLDER=Processed
EMAIL_POLL_INTERVAL_MINUTES=5

# SMTP for Notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@gateplatform.com
SMTP_TLS=true
