{
    "template_name": "ISF Filing (10+2)",
    "template_type": "field_list",
    "document_type": "isf_filing",
    "description": "Extracts key fields from Importer Security Filing (ISF) 10+2 documents. Captures the 10 importer data elements and 2 carrier elements required for ocean freight.",
    "version": "1.0.0",
    "confidence_threshold": 0.80,
    "classification_categories": [
        "isf",
        "security",
        "customs",
        "ocean"
    ],
    "matching_keywords": [
        "ISF",
        "Importer Security Filing",
        "10+2",
        "security filing",
        "AMS",
        "CBP",
        "ship to party",
        "manufacturer",
        "container stuffing"
    ],
    "field_definitions": [
        {
            "field_name": "isf_transaction_number",
            "display_name": "ISF Transaction Number",
            "field_type": "string",
            "description": "CBP-assigned ISF transaction number",
            "required": false,
            "extraction_hints": [
                "ISF No",
                "Transaction Number",
                "ISF ID"
            ],
            "entity_type": "document_id"
        },
        {
            "field_name": "filing_type",
            "display_name": "Filing Type",
            "field_type": "string",
            "description": "Type of ISF (ISF-10, ISF-5)",
            "required": true,
            "extraction_hints": [
                "Type",
                "ISF-10",
                "ISF-5"
            ],
            "default_value": "ISF-10"
        },
        {
            "field_name": "filing_date",
            "display_name": "Filing Date",
            "field_type": "date",
            "description": "Date the ISF was filed",
            "required": true,
            "extraction_hints": [
                "Filing Date",
                "Submitted",
                "Date"
            ],
            "entity_type": "date"
        },
        {
            "field_name": "estimated_arrival_date",
            "display_name": "Estimated Arrival Date",
            "field_type": "date",
            "description": "Expected arrival date at first US port",
            "required": true,
            "extraction_hints": [
                "ETA",
                "Arrival Date",
                "Estimated Arrival"
            ],
            "entity_type": "date"
        },
        {
            "field_name": "bl_number",
            "display_name": "Bill of Lading Number",
            "field_type": "string",
            "description": "Master or house bill of lading number",
            "required": true,
            "extraction_hints": [
                "B/L",
                "BOL",
                "Bill of Lading"
            ],
            "entity_type": "document_id"
        },
