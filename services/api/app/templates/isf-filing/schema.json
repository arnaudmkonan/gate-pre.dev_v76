            "extraction_hints": [
                "Ship To",
                "Delivery Address",
                "Destination"
            ],
            "entity_type": "organization"
        },
        {
            "field_name": "ship_to_party_address",
            "display_name": "Ship To Party Address",
            "field_type": "address",
            "description": "Complete delivery address",
            "required": true,
            "entity_type": "location"
        },
        {
            "field_name": "manufacturer_name",
            "display_name": "Manufacturer Name",
            "field_type": "string",
            "description": "Name of the manufacturer",
            "required": true,
            "extraction_hints": [
                "Manufacturer",
                "Factory",
                "Producer"
            ],
            "entity_type": "organization"
        },
        {
            "field_name": "manufacturer_address",
            "display_name": "Manufacturer Address",
            "field_type": "address",
            "description": "Complete manufacturer address",
            "required": true,
            "entity_type": "location"
        },
        {
            "field_name": "manufacturer_id",
            "display_name": "Manufacturer ID (MID)",
