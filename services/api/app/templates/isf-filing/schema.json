                    "field_name": "hts_number",
                    "display_name": "HTS Number",
                    "field_type": "string",
                    "validation_regex": "^[0-9]{6}$"
                }
            ]
        },
        {
            "field_name": "container_stuffing_location_name",
            "display_name": "Container Stuffing Location Name",
            "field_type": "string",
            "description": "Where the container was stuffed/loaded",
            "required": true,
            "extraction_hints": [
                "Stuffing Location",
                "Loading Location"
            ],
            "entity_type": "organization"
        },
        {
            "field_name": "container_stuffing_location_address",
            "display_name": "Container Stuffing Location Address",
            "field_type": "address",
            "description": "Address where container was stuffed",
            "required": true,
            "entity_type": "location"
        },
        {
            "field_name": "consolidator_name",
            "display_name": "Consolidator Name",
            "field_type": "string",
            "description": "Name of the consolidator (if applicable)",
            "required": false,
            "extraction_hints": [
                "Consolidator",
                "Forwarder"
            ],
            "entity_type": "organization"
        },
        {
            "field_name": "vessel_name",
            "display_name": "Vessel Name",
            "field_type": "string",
            "description": "Name of the ocean vessel (Carrier element)",
            "required": false,
            "extraction_hints": [
                "Vessel",
                "Ship"
            ],
            "entity_type": "string"
        },
        {
            "field_name": "vessel_country",
            "display_name": "Vessel Country of Registration",
            "field_type": "string",
            "description": "Country where vessel is registered",
            "required": false,
            "extraction_hints": [
                "Flag",
                "Vessel Country",
                "Registration"
            ],
            "entity_type": "location"
        },
