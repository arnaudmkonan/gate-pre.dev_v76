            "field_name": "seller_address",
            "display_name": "Seller Address",
            "field_type": "address",
            "description": "Complete address of the seller",
            "required": true,
            "entity_type": "location"
        },
        {
            "field_name": "buyer_name",
            "display_name": "Buyer Name",
            "field_type": "string",
            "description": "Name and address of the buyer",
            "required": true,
            "extraction_hints": [
                "Buyer",
                "Purchaser",
                "Customer"
            ],
            "entity_type": "organization"
        },
