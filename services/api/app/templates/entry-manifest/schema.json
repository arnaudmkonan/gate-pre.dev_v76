            "display_name": "Entry Number",
            "field_type": "string",
            "description": "11-digit customs entry number",
            "required": true,
            "validation_regex": "^[A-Z0-9]{3}[0-9]{8}$",
            "extraction_hints": [
                "Entry Number",
                "Entry No",
                "Entry #"
            ],
            "entity_type": "document_id"
        },
