{
    "template_name": "Entry Manifest (CBP 3461)",
    "template_type": "field_list",
    "document_type": "entry_manifest",
    "description": "Extracts key fields from CBP Form 3461 Entry/Immediate Delivery documents. Used to secure release of goods before full entry summary filing.",
