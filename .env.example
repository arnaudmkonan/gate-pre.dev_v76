# =============================================================================
# GATES Platform - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# ⚠️ NEVER commit the .env file to git!

# -----------------------------------------------------------------------------
# OpenAI (Required — powers DocuMind AI extraction engine)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# -----------------------------------------------------------------------------
# Security (Required — generate unique values per instance)
# -----------------------------------------------------------------------------
# Generate with: openssl rand -hex 64
SECRET_KEY=change-this-to-a-secure-random-string-in-production

# -----------------------------------------------------------------------------
# Storage Configuration
# -----------------------------------------------------------------------------
# Options: 'local' (development) or 'supabase' (cloud)
STORAGE_PROVIDER=local
MAX_UPLOAD_SIZE_MB=100
SIGNED_URL_TTL_SECONDS=3600

# Supabase (Optional — only if STORAGE_PROVIDER=supabase)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_ENDPOINT=
SUPABASE_STORAGE_ACCESS_KEY=
SUPABASE_STORAGE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=raw-files
SUPABASE_STORAGE_REGION=us-east-1

# -----------------------------------------------------------------------------
# Vector Store
# -----------------------------------------------------------------------------
VECTOR_STORE_BACKEND=pgvector
VECTOR_STORE_URL=

# -----------------------------------------------------------------------------
# Sentry (Optional — error tracking)
# -----------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENV=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENABLED=false

# -----------------------------------------------------------------------------
# Email Ingestion (Optional — IMAP document monitoring)
# -----------------------------------------------------------------------------
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_USER=
EMAIL_IMAP_PASSWORD=
EMAIL_FOLDER=GATE-Docs
EMAIL_PROCESSED_FOLDER=Processed
EMAIL_LOOKBACK_DAYS=7
# EMAIL_ALLOWED_SENDERS=supplier@example.com,customs@broker.com
# EMAIL_SUBJECT_KEYWORDS=invoice,customs,entry,shipment

# -----------------------------------------------------------------------------
# SMTP (Optional — for password reset emails and notifications)
# -----------------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=noreply@gates-platform.com
