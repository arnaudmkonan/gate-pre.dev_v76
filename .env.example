

# -----------------------------------------------------------------------------
# OpenAI (Required — powers DocuMind AI extraction engine)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# -----------------------------------------------------------------------------
# Security (Required — generate unique values per instance)
# -----------------------------------------------------------------------------
# Generate with: openssl rand -hex 64
SECRET_KEY=change-this-to-a-secure-random-string-in-production

# Demo login users (admin@example.com / demo@example.com) — enable for local Docker only
SEED_DEMO_USERS=false

# Public app URL (password reset links in email)
FRONTEND_URL=http://localhost:3000

# Portal — require email verification after invite signup (production pilots)
REQUIRE_EMAIL_VERIFICATION=false

# Stripe (optional paid pilot) — checkout + webhook
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID_PILOT=price_...

# Redis published on host loopback only (default). Use 0.0.0.0 only if needed.
REDIS_PUBLISH_HOST=127.0.0.1

# SMTP (required in production) — see docs/PILOT_SMTP.md
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USERNAME=resend
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=noreply@example.com
# SMTP_TLS=true

# ACE filing — see docs/PILOT_ACE.md
# ACE_SFTP_ENABLED=false
# ACE_ALLOW_SIMULATION=true

# -----------------------------------------------------------------------------
# Storage Configuration
# -----------------------------------------------------------------------------
# Options: 'local' (development) or 'supabase' (cloud)
STORAGE_PROVIDER=local
MAX_UPLOAD_SIZE_MB=100
SIGNED_URL_TTL_SECONDS=3600

# Supabase (Optional — only if STORAGE_PROVIDER=supabase)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_ENDPOINT=
SUPABASE_STORAGE_ACCESS_KEY=
SUPABASE_STORAGE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=raw-files
SUPABASE_STORAGE_REGION=us-east-1

# -----------------------------------------------------------------------------
# Vector Store
# -----------------------------------------------------------------------------
VECTOR_STORE_BACKEND=pgvector
VECTOR_STORE_URL=

# -----------------------------------------------------------------------------
# Sentry (Optional — error tracking)
# -----------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENV=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENABLED=false

# -----------------------------------------------------------------------------
# Email Ingestion (Optional — IMAP document monitoring)
# -----------------------------------------------------------------------------
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_USER=
EMAIL_IMAP_PASSWORD=
EMAIL_FOLDER=GATE-Docs
EMAIL_PROCESSED_FOLDER=Processed
EMAIL_LOOKBACK_DAYS=7
# EMAIL_ALLOWED_SENDERS=supplier@example.com,customs@broker.com
# EMAIL_SUBJECT_KEYWORDS=invoice,customs,entry,shipment

# (SMTP for password reset — see docs/PILOT_SMTP.md and variables near top of this file)
